src/*.egg-info/
.installed.cfg
*.egg

# --- Python Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Testing & Code Quality ---
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.mypy_cache/
.pyre/
.pytype/

# --- Node & Next.js Dashboard ---
node_modules/
dashboard/node_modules/
.next/
dashboard/.next/
dashboard/out/
dashboard/build/
.yarn/*
